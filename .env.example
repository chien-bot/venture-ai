# Copy this file to backend/.env for a local backend launch. Do not commit .env.

# true is for offline development and automated regression tests only.
# Use false for the final live-model U1-U6 evaluation.
USE_MOCK_API=true

# Configure exactly one provider for live-model runs.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MODEL_MAIN=Qwen/Qwen2.5-7B-Instruct
MODEL_LIGHT=Qwen/Qwen2.5-7B-Instruct

# Replace with the final Git tag during release packaging.
AGENT_VERSION=ventureai-v2-candidate

# Optional: set an external database location for testing or deployment.
VENTUREAI_DB_PATH=

# Optional Neo4j configuration. Leave blank to use SQLite-only mode.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
