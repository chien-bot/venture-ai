    {
      "id": "proj_bad6ae35",
      "type": "Project",
      "label": "数湖启智-项目书0410",
      "properties": {
        "industry": "通用",
        "source": "科技创新类1",
        "technologies": [
          "自动驾驶",
          "AR",
          "MR",
          "知识图谱",
          "IoT",
